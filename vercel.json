{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    { "source": "/a01-tieu-duong", "destination": "/a01-tieu-duong/", "permanent": false },
    { "source": "/a01-gia-nha", "destination": "/a01-gia-nha/", "permanent": false },
    { "source": "/a02-recommend", "destination": "/a02-recommend/", "permanent": false },
    { "source": "/a05-cnn", "destination": "/a05-cnn/", "permanent": false },
    { "source": "/a06-rnn", "destination": "/a06-rnn/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.onnx",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
